<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Digify Menu OTP</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f6f6f6;
      font-family: Arial, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding: 40px 0">
          <table
            width="100%"
            style="
              max-width: 500px;
              background: #ffffff;
              border-radius: 8px;
              padding: 30px;
            "
          >
            <tr>
              <td style="text-align: center; padding-bottom: 20px">
                <h2 style="margin: 0; color: #ff7a18">Digify Menu</h2>
              </td>
            </tr>

            <tr>
              <td style="color: #333333; font-size: 15px; padding-bottom: 20px">
                Hi <%= userName || "there" %>,<br /><br />
                Use the OTP below to continue. This code is valid for
                <b>10 minutes</b>.
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 20px 0">
                <div
                  style="
                    display: inline-block;
                    padding: 14px 28px;
                    font-size: 22px;
                    letter-spacing: 4px;
                    color: #ffffff;
                    background: linear-gradient(90deg, #ff7a18, #ff9f45);
                    border-radius: 6px;
                    font-weight: bold;
                  "
                >
                  <%= otp %>
                </div>
              </td>
            </tr>

            <tr>
              <td style="color: #666666; font-size: 13px; padding-top: 20px">
                If you didn’t request this, you can safely ignore this email.
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding-top: 30px;
                  font-size: 12px;
                  color: #999999;
                  text-align: center;
                "
              >
                © <%= new Date().getFullYear() %> Digify Menu
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
